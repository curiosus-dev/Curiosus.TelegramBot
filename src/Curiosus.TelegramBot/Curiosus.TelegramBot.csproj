<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <PackageId>Curiosus.TelegramBot</PackageId>
        <Version>2.0.0</Version>
        <Description>Telegram bot infrastructure: command dispatching, state management, update queue, authentication.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/curiosus-dev/Curiosus.TelegramBot</PackageProjectUrl>
        <RepositoryUrl>https://github.com/curiosus-dev/Curiosus.TelegramBot</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>telegram;bot;commands;state-management;dotnet;csharp;telegram-bot-api</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>See CHANGELOG.md</PackageReleaseNotes>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Curiosus.TelegramBot.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Telegram.Bot" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

</Project>
