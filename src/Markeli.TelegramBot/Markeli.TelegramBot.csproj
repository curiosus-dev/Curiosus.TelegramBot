<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<PackageId>Markeli.TelegramBot</PackageId>
		<Version>1.0.0</Version>
		<Authors>Maxim Markelow</Authors>
		<Description>Telegram bot infrastructure: command dispatching, state management, update queue, authentication.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Markeli/Markeli.TelegramBot</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Markeli/Markeli.TelegramBot</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>telegram;bot;commands;state-management;dotnet;csharp;telegram-bot-api</PackageTags>
		<Copyright>Copyright (c) 2026 Maxim Markelow</Copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>See CHANGELOG.md</PackageReleaseNotes>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- SourceLink -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Deterministic builds for CI -->
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Markeli.TelegramBot.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Build.Tasks.Git" />
		<PackageReference Include="Telegram.Bot" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

</Project>
