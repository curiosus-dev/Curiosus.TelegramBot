<Project>

    <!--
        Synced from https://github.com/curiosus-dev/dotnet-tools, do not edit in place.
        Imported first from the repository Directory.Build.props, so projects can override any value.
        Source Link itself is part of the .NET 8+ SDK, no package reference is needed.
    -->
    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!--
        Package metadata shared by all Curiosus packages. A project with more authors keeps them:
        <Authors>$(CuriosusAuthors), Jane Doe (@jane)</Authors>
        Copyright matches LICENSE: the maintainer and contributors (the organization is not a legal entity);
        original notices of forked code stay in LICENSE.
    -->
    <PropertyGroup>
        <CuriosusAuthors>Curiosus Dev, Maxim Markelow (@markeli)</CuriosusAuthors>
        <Authors>$(CuriosusAuthors)</Authors>
        <Company>Curiosus Dev</Company>
        <Copyright>Copyright © $([System.DateTime]::UtcNow.Year) Maxim Markelow and contributors</Copyright>
        <PackageIcon>curiosus-icon.png</PackageIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)curiosus-icon.png" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <!--
        The version is the first released section ("## [x.y.z] - yyyy-mm-dd", [Unreleased] is skipped) of CHANGELOG.md
        next to the project, or of the repository CHANGELOG.md. Each project reads its own changelog, so versions of
        ProjectReference dependencies are right too, which a global /p:Version would break. A <Version> in the project
        file still wins.
    -->
    <PropertyGroup>
        <_CuriosusProjectChangelog>$(MSBuildProjectDirectory)/CHANGELOG.md</_CuriosusProjectChangelog>
        <_CuriosusRootChangelog
            >$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..', 'CHANGELOG.md'))</_CuriosusRootChangelog>
        <CuriosusChangelog Condition="Exists('$(_CuriosusProjectChangelog)')">$(_CuriosusProjectChangelog)</CuriosusChangelog>
        <CuriosusChangelog Condition="'$(CuriosusChangelog)' == '' and Exists('$(_CuriosusRootChangelog)')"
            >$(_CuriosusRootChangelog)</CuriosusChangelog>
        <_CuriosusChangelogBody Condition="'$(CuriosusChangelog)' != ''"
            >$([System.IO.File]::ReadAllText('$(CuriosusChangelog)'))</_CuriosusChangelogBody>
        <_CuriosusVersionRegex>(?m)^## \[\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?\]</_CuriosusVersionRegex>
        <!-- Match converts to its value: "## [x.y.z]", or an empty string. -->
        <_CuriosusVersionHeading Condition="'$(_CuriosusChangelogBody)' != ''"
            >$([System.Text.RegularExpressions.Regex]::Match($(_CuriosusChangelogBody), $(_CuriosusVersionRegex)))
        </_CuriosusVersionHeading>
        <CuriosusChangelogVersion Condition="'$(_CuriosusVersionHeading.Trim())' != ''"
            >$(_CuriosusVersionHeading.Trim().Substring(4).Replace(']', ''))</CuriosusChangelogVersion>
        <Version Condition="'$(CuriosusChangelogVersion)' != ''">$(CuriosusChangelogVersion)</Version>
    </PropertyGroup>

    <Target Name="CuriosusCheckPackageVersion" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' != 'false'">
        <Error Condition="'$(CuriosusChangelogVersion)' == ''"
               Text="No '## [x.y.z]' section in CHANGELOG.md of the project or of the repository: it sets the version." />
    </Target>

    <!--
        Release notes link to the CHANGELOG at the commit the package is built from: it doesn't depend on the branch name,
        and shows the notes as they were at release. Source Link provides the repository URL and the commit.
    -->
    <Target Name="CuriosusReleaseNotes" BeforeTargets="GenerateNuspec" DependsOnTargets="InitializeSourceControlInformation"
            Condition="'$(PackageReleaseNotes)' == '' and '$(CuriosusChangelog)' != ''">
        <PropertyGroup>
            <_CuriosusGitSuffix>(\.git)?/?$</_CuriosusGitSuffix>
            <_CuriosusRepositoryUrl
                >$([System.Text.RegularExpressions.Regex]::Replace($(PrivateRepositoryUrl), $(_CuriosusGitSuffix), ''))
            </_CuriosusRepositoryUrl>
            <_CuriosusRepositoryUrl>$(_CuriosusRepositoryUrl.Trim())</_CuriosusRepositoryUrl>
            <_CuriosusChangelogPath
                >$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory)../, $(CuriosusChangelog)))</_CuriosusChangelogPath>
            <_CuriosusChangelogPath>$(_CuriosusChangelogPath.Replace('\', '/'))</_CuriosusChangelogPath>
            <PackageReleaseNotes Condition="'$(_CuriosusRepositoryUrl)' != '' and '$(SourceRevisionId)' != ''"
                >$(_CuriosusRepositoryUrl)/blob/$(SourceRevisionId)/$(_CuriosusChangelogPath)</PackageReleaseNotes>
        </PropertyGroup>
    </Target>

    <!-- A README.md next to the project is the package readme on nuget.org. -->
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
        <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

</Project>
