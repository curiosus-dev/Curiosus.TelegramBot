<?xml version="1.0" encoding="utf-8"?>
<!-- Synced from https://github.com/curiosus-dev/dotnet-tools, do not edit in place. -->
<configuration>
    <!--
        <clear /> drops any source inherited from machine-, user- or ancestor-level NuGet.config,
        so restore resolves packages exclusively from nuget.org regardless of the host machine setup.
    -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>

    <!-- Prevents an inherited <disabledPackageSources> entry from switching nuget.org off. -->
    <disabledPackageSources>
        <clear />
    </disabledPackageSources>

    <!-- Every package pattern maps to nuget.org: no package can be silently served by another feed. -->
    <packageSourceMapping>
        <clear />
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
